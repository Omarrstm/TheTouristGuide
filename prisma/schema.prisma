// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  password    String
  homeCountry String?
  createdAt   DateTime @default(now())

  sessions Session[]
  places   Place[]
  reviews  Review[]

  guideProfile GuideProfile?

  travelerConversations Conversation[] @relation("TravelerConversations")
  guideConversations    Conversation[] @relation("GuideConversations")
  sentMessages          Message[]      @relation("SentMessages")

  itineraries Itinerary[]
  notifications Notification[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Country {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  places Place[]
  guides GuideProfile[]
}

model Place {
  id          String  @id @default(cuid())
  name        String
  city        String
  description String
  isHiddenGem Boolean @default(false)
  createdAt   DateTime @default(now())

  latitude         Float?
  longitude        Float?
  formattedAddress String?
  googlePlaceId    String?

  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  photos  PlacePhoto[]
  reviews Review[]

  itineraryPlaces ItineraryPlace[]
}

model PlacePhoto {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  uploadedByUserId String?
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeId, userId])
}

model GuideProfile {
  id        String   @id @default(cuid())
  bio       String?
  languages String[] @default([])
  city      String
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  countryId String
  country   Country @relation(fields: [countryId], references: [id])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  travelerId String
  traveler   User   @relation("TravelerConversations", fields: [travelerId], references: [id], onDelete: Cascade)

  guideId String
  guide   User   @relation("GuideConversations", fields: [guideId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([travelerId, guideId])
}

model Itinerary {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ItineraryPlace[]
}

model ItineraryPlace {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([itineraryId, placeId])
}

enum NotificationType {
  NEW_MESSAGE
  NEW_REVIEW
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String?
  href      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Message {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
